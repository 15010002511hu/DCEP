<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:dubbo="http://dubbo.apache.org/schema/dubbo"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
	http://www.springframework.org/schema/beans/spring-beans.xsd
	http://dubbo.apache.org/schema/dubbo
	http://dubbo.apache.org/schema/dubbo/dubbo.xsd">

    <bean id="httpClientService" class="com.dcep.supergw.service.impl.HttpClientServiceImpl"/>
    <dubbo:service interface="com.dcep.supergw.api.HttpClientService" ref="httpClientService" group="wallet"
                   timeout="3000" version="1.0.0">
 
    </dubbo:service>

</beans>