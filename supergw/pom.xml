                <version>${acctrans.version}</version>
            </dependency>

            <!--  公共管理jar引用  -->
            <dependency>
                <groupId>com.dcep.doms</groupId>
                <artifactId>doms-fi-api</artifactId>
                <version>${doms-fi-api.version}</version>
            </dependency>

            <dependency>
                <groupId>com.dcep.doms</groupId>
                <artifactId>doms-monitor-api</artifactId>
                <version>${doms-monitor-api.version}</version>
            </dependency>

            <dependency>
                <groupId>com.dcep.doms</groupId>
                <artifactId>doms-exchange-api</artifactId>
                <version>${doms-exchange-api.version}</version>
            </dependency>

           <dependency>
                <groupId>com.dcep.doms</groupId>
                <artifactId>doms-dynamic-config-api</artifactId>
