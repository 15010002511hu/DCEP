            <!-- 密码服务平台 -->
            <dependency>
                <groupId>com.dcep</groupId>
                <artifactId>EncryptSuit</artifactId>
                <version>${encryptsuit.version}</version>
            </dependency>

            <!--  钱包jar引用  -->
            <dependency>
                <groupId>com.dcep</groupId>
                <artifactId>uniwlt-dependencies-bom</artifactId>
                <version>${uniwlt.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 机构对账 -->
            <dependency>
                <groupId>com.dcep</groupId>
                <artifactId>dcreconsum-dto</artifactId>
                <version>${dcreconsum.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dcep</groupId>
                <artifactId>dcreconsum-api</artifactId>
                <version>${dcreconsum.version}</version>
            </dependency>

            <!-- 账务系统 -->
            <dependency>
                <groupId>com.dcep</groupId>
                <artifactId>dctrans-dto</artifactId>
                <version>${dctrans.version}</version>
            </dependency>
